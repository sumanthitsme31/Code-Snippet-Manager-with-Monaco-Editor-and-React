# SnippetVault Environment Variables
# Copy this file to .env and fill in the values.

# A GitHub Personal Access Token can optionally be provided for authenticated API requests.
# This is not required for the core functionality but allows for higher rate limits
# and authenticated Gist creation (tied to your account).
# Generate one at: https://github.com/settings/tokens (no scopes needed for public Gists)
REACT_APP_GITHUB_TOKEN=

# Vite uses VITE_ prefix for env vars exposed to the browser
VITE_GITHUB_TOKEN=
